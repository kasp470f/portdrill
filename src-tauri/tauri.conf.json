{
  "$schema": "https://raw.githubusercontent.com/nicedayfor/tauri/v2/crates/tauri-cli/schema.json",
  "productName": "PortDrill",
  "version": "0.2.10",
  "identifier": "com.portdrill.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PortDrill",
        "minWidth": 650,
        "width": 650,
        "minHeight": 750,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwRDE3QTkxNjU1MzcwQTIKUldTaWNGTmxrWHJSOEJac3pPYUc5MmhMZ2pPTGpWYVNwVjc4eXhnZTcxL0MzMm5ic00wVjRVL24K",
      "endpoints": [
        "https://github.com/kasp470f/portdrill/releases/latest/download/latest.json"
      ]
    }
  }
}
